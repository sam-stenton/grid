{
  "rules": {
    "rooms": {
      "$code": {
        ".read": "auth != null",
        ".validate": "$code.matches(/^[A-Z]{4}$/)",
        "meta": {
          ".write": "auth != null && (!data.exists() || data.child('host').val() === auth.uid || data.child('created').val() < now - 43200000)",
          ".validate": "!newData.exists() || (newData.child('host').val() === auth.uid && newData.child('created').isNumber())"
        },
        "state": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid"
        },
        "players": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/meta').exists()",
            ".validate": "newData.hasChild('name')",
            "name": {
              ".validate": "newData.isString() && newData.val().length >= 1 && newData.val().length <= 16"
            },
            "joined": {
              ".validate": "newData.isNumber()"
            },
            "online": {
              ".validate": "newData.isBoolean()"
            },
            "score": {
              ".validate": "newData.isNumber() && (newData.val() === data.val() || root.child('rooms/' + $code + '/meta/host').val() === auth.uid)"
            },
            "avatar": {
              ".validate": "newData.isString() && newData.val().length <= 24"
            },
            "$other": {
              ".validate": false
            }
          }
        },
        "cards": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$uid": {
            ".write": "auth != null && auth.uid === $uid && root.child('rooms/' + $code + '/players/' + $uid).exists() && root.child('rooms/' + $code + '/state/locked').val() !== true",
            ".validate": "newData.hasChildren(['0', '1', '2', '3', '4', '5', '6', '7', '8'])"
          }
        },
        "marks": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$uid": {
            "$cell": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/state/locked').val() === true",
              ".validate": "$cell.matches(/^[0-8]$/) && newData.isString() && newData.val() === root.child('rooms/' + $code + '/state/callKey').val() && root.child('rooms/' + $code + '/cards/' + $uid + '/' + $cell).val() === root.child('rooms/' + $code + '/state/last').val()"
            }
          }
        },
        "answers": {
          ".write": "auth != null && root.child('rooms/' + $code + '/meta/host').val() === auth.uid",
          "$uid": {
            "$key": {
              ".write": "auth != null && auth.uid === $uid && !data.exists() && root.child('rooms/' + $code + '/players/' + $uid).exists() && root.child('rooms/' + $code + '/state/askKey').val() === $key",
              ".validate": "(newData.isString() && newData.val().length <= 40) || newData.isNumber()"
            }
          }
        },
        "$other": {
          ".validate": false
        }
      }
    },
    "tests": {
      "$uid": {
        ".read": "auth != null && auth.uid === $uid",
        ".write": "auth != null && auth.uid === $uid"
      }
    }
  }
}
